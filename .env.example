# PurelyMail API Key (required)
PURELYMAIL_API_KEY=your_api_key_here

# Password for logging in to the panel (required)
# Plain text, or preferably a bcrypt hash (escape each $ as \$ in this file; see README)
ADMIN_PASSWORD=choose_a_strong_password

# Secret used to sign login session tokens (required)
# Generate one with: openssl rand -base64 32
JWT_SECRET=your_random_secret_here
