# PurelyMail API Key (required)
PURELYMAIL_API_KEY=your_api_key_here

# Password for logging in to the panel (required)
# Plain text, or preferably a bcrypt hash (escape each $ as \$ in this file; see README)
ADMIN_PASSWORD=choose_a_strong_password

# Secret used to sign login session tokens (required)
# Generate one with: openssl rand -base64 32
JWT_SECRET=your_random_secret_here

# --- Webmail (the Mail page) ---
# Supabase project that stores the encrypted app passwords (run supabase/mailbox_credentials.sql first)
SUPABASE_URL=https://your-project.supabase.co
# Service role key: server-side only, never expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Key used to encrypt app passwords before they are stored. Generate one with: openssl rand -base64 32
# If it changes, new app passwords are created automatically; delete the old ones in PurelyMail.
MAIL_CREDENTIALS_KEY=your_random_key_here

# Optional: override the mail servers (defaults are PurelyMail's)
# MAIL_IMAP_HOST=imap.purelymail.com
# MAIL_IMAP_PORT=993
# MAIL_SMTP_HOST=smtp.purelymail.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=true   # false = STARTTLS (default for ports 587 and 25)
